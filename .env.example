# Harbour Mooring Waitlist Board - environment template.
#
# Copy to .env (or let `bash install.sh` do it for you) and adjust as needed.
# Every value below has a working development default in code, so the app boots
# with no .env file at all.

# Signed session cookie key. install.sh generates a unique value on first run.
# Leave blank to use the built-in development default.
SESSION_SECRET=

# Embedded SQLite database. A relative path resolves against backend/.
DATABASE_URL=sqlite:///./harbour.db

# Seed the demo harbour on the normal boot path when rows are missing.
SEED_ON_START=true

# Verbose FastAPI behaviour. Never enable this in production.
DEBUG=false

# Browser origins allowed to call the API directly (the SPA is same-origin).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Port for the API service. The single-page app is served on 5173.
PORT=8000
